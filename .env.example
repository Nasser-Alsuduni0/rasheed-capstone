# Examples only; never commit real credentials.
# Compose sets its own internal Redis URL. Local processes need a reachable Redis.
RASHEED_MODEL_PATH=models/scholarship_rules.v1.json
RASHEED_REDIS_URL=redis://localhost:6379/0
RASHEED_REDIS_TIMEOUT_SECONDS=1.0
RASHEED_LOG_LEVEL=INFO
# Compose-specific overrides:
RASHEED_PORT=8010
RASHEED_IMAGE=rasheed-capstone:dev
